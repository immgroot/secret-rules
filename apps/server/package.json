{
  "name": "@secret-rules/server",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "rules:inspect": "node src/rules/inspect.ts",
    "rules:simulate": "node src/rules/simulate.ts --sets=100"
  },
  "dependencies": {
    "@secret-rules/shared": "workspace:*",
    "socket.io": "4.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": { "socket.io-client": "4.8.3" }
}
