# Local development only. Never commit the real .env file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
RECONNECT_GRACE_MS=60000
ROOM_IDLE_TIMEOUT_MS=7200000
AFK_TIMEOUT_MS=180000

# Production must explicitly set NODE_ENV=production, HOST, PORT, and ALLOWED_ORIGINS.
# Origins must be exact HTTP(S) origins without paths; TLS is required for public hosting.
# HOST is an IPv4/IPv6 bind address. Public binding needs a reviewed deployment.
# No credentials or gameplay secrets are required for foundation.
