# Public, non-secret Socket.IO server URL. Use the deployed server origin in production.
# Next.js embeds NEXT_PUBLIC_ values at build time. Never put secrets here.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# Private server-side account configuration. Generate a high-entropy secret.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_JWT_ISSUER=http://localhost:3000/api/auth
AUTH_JWT_AUDIENCE=secret-rules-realtime

# Optional OAuth providers. Set both variables for a provider or leave both empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Transactional account email (Resend). Never prefix secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
AUTH_EMAIL_FROM=SECRET RULES <accounts@example.com>
